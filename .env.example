# Copy this file to .env when local scripts or future cloud tooling need
# environment-specific values. Do not commit real secrets.

# WeChat Mini Program AppID. This is an identifier, not a secret.
WECHAT_APP_ID=your-wechat-mini-program-appid

# WeChat CloudBase environment ID. This is an identifier, not a secret.
WECHAT_CLOUD_ENV_ID=your-cloud-env-id

# Order notification template. Set this exact variable in the CloudBase
# environment variables for the createOrder cloud function.
ORDER_NOTIFY_TEMPLATE_ID=your-template-id

# Optional monthly report subscribe message template.
MONTHLY_REPORT_TEMPLATE_ID=your-monthly-report-template-id

# Optional third-party recipe API keys. Keep real values in local or cloud
# environment variables only.
TIANAPI_KEY=
JUHE_API_KEY=
