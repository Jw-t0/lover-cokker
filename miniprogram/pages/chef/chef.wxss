.tabs {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tab-button {
  height: 92rpx;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  line-height: 1.2;
  border-radius: 999rpx;
  font-weight: 900;
  box-sizing: border-box;
  text-align: center;
  white-space: nowrap;
}

.tab-dark {
  background: #4d373e;
  color: #ffffff;
}

.tab-soft {
  background: #ffe3ea;
  color: #c94c6c;
}

.tab-warm {
  background: #ffe29f;
  color: #4d373e;
}

.subscribe-button {
  height: 84rpx;
  margin: 0 0 52rpx;
  border-radius: 999rpx;
  background: #fff8fb;
  color: #825e4b;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 84rpx;
}

.actions {
  margin-top: 36rpx;
  padding: 38rpx;
  border-radius: 24rpx;
}

.action-button {
  margin: 0 0 26rpx;
}

.last-action {
  margin-bottom: 0;
}

.stats-mask {
  position: fixed;
  inset: 0;
  background: rgba(34, 29, 23, 0.38);
  z-index: 30;
  animation: overlay-fade-in 220ms ease-out both;
}

.stats-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 31;
  background: #ffffff;
  border-radius: 34rpx 34rpx 0 0;
  padding: 46rpx 38rpx calc(46rpx + env(safe-area-inset-bottom));
  animation: panel-slide-up 340ms cubic-bezier(.16, 1, .3, 1) both;
}

.panel-title {
  font-size: 38rpx;
  font-weight: 900;
  margin-bottom: 36rpx;
}

.panel-close {
  color: #c94c6c;
  font-size: 28rpx;
  font-weight: 800;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #eee4d5;
  color: #8b7078;
}

.stat-value {
  color: #ff7297;
  font-size: 34rpx;
  font-weight: 900;
}

.section-title {
  margin: 36rpx 0 24rpx;
  font-size: 34rpx;
  font-weight: 900;
}
