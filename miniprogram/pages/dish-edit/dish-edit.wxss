.form {
  padding: 36rpx;
}

.image-picker {
  width: 180rpx;
  height: 180rpx;
  border-radius: 32rpx;
  margin: 0 auto;
  background: #fff1f6;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  font-size: 76rpx;
}

.dish-image {
  width: 100%;
  height: 100%;
}

.image-tip {
  margin: 18rpx 0 42rpx;
  text-align: center;
  color: #c94c6c;
  font-weight: 800;
}

.image-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin: -22rpx 0 34rpx;
  font-size: 24rpx;
}

.icon-picker-trigger {
  color: #d84d78;
  font-weight: 800;
}

.image-action-divider,
.image-action-note {
  color: #a98f92;
}

.label {
  margin: 30rpx 0 16rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.no-margin {
  margin-top: 0;
}

.picker {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  border: 1rpx solid #f3e5e5;
  border-radius: 20rpx;
  background: #ffffff;
  color: #2d2d2d;
}

.status-row {
  margin-top: 36rpx;
}

.method-textarea {
  min-height: 180rpx;
}

.helper {
  margin-top: 12rpx;
  line-height: 1.45;
  font-size: 24rpx;
}

.save {
  margin-top: 44rpx;
}

.icon-picker-layer {
  position: fixed;
  z-index: 20;
  inset: 0;
}

.icon-picker-mask {
  position: absolute;
  inset: 0;
  background: rgba(45, 30, 34, 0.42);
}

.icon-picker-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 78vh;
  padding: 36rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: #fffaf8;
  box-sizing: border-box;
}

.icon-picker-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.icon-picker-title {
  color: #3c292c;
  font-size: 34rpx;
  font-weight: 800;
}

.icon-picker-subtitle {
  margin-top: 8rpx;
  color: #a98f92;
  font-size: 23rpx;
}

.icon-picker-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f7e9e9;
  color: #8f7477;
  font-size: 42rpx;
  line-height: 50rpx;
  text-align: center;
}

.icon-picker-scroll {
  max-height: calc(78vh - 150rpx);
}

.icon-group {
  margin-bottom: 24rpx;
}

.icon-group-name {
  margin-bottom: 14rpx;
  color: #8f646b;
  font-size: 24rpx;
  font-weight: 800;
}

.icon-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 14rpx;
}

.icon-option {
  aspect-ratio: 1;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.icon-option.selected {
  border-color: #f05f88;
  background: #fff0f4;
}

.icon-option-emoji {
  font-size: 42rpx;
  line-height: 1;
}
