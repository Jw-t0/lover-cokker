<view class="page profile-page">
  <view class="heart">♡</view>
  <view class="page-title center">编辑个人资料</view>
  <view class="page-subtitle center">设置你的头像和昵称</view>
  <view wx:if="{{fromInvite}}" class="invite-profile-note">邀请卡会展示你的头像和昵称，请先补充完整</view>

  <view wx:if="{{loading}}" class="profile-card card profile-loading">正在读取你的资料</view>
  <view wx:elif="{{error}}" class="profile-card card profile-error">
    <view class="section-title">资料暂时打不开</view>
    <view class="muted">{{error}}</view>
    <button class="soft-button" hover-class="tap-feedback" hover-stay-time="120" bindtap="retry">重新加载</button>
  </view>
  <block wx:else>
  <view class="profile-card card">
    <button class="avatar-wrap" hover-class="tap-feedback" hover-stay-time="120" open-type="chooseAvatar" bindchooseavatar="chooseAvatar">
      <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill"></image>
      <text wx:else class="avatar-plus">＋</text>
    </button>
    <view class="avatar-tip">点击头像更换</view>

    <view class="label">我的昵称</view>
    <view class="input-wrap">
      <input class="input" value="{{nickname}}" bindinput="onNicknameInput" maxlength="12" placeholder="请输入昵称" />
      <text class="count-text">{{count}}/12</text>
    </view>
    <view class="help">昵称将显示在首页和另一半的页面中</view>
  </view>

  <button class="primary-button save" hover-class="tap-feedback" hover-stay-time="120" disabled="{{saving}}" bindtap="save">{{saving ? '保存中' : '保存资料'}}</button>
  <view class="bottom-tip">头像和昵称将用于你们的情侣小饭桌</view>
  </block>
</view>
