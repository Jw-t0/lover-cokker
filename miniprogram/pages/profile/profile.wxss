.center {
  text-align: center;
}

.heart {
  width: 104rpx;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  border-radius: 50%;
  background: #ffe2ee;
  color: #c94c6c;
  font-size: 52rpx;
  margin: 48rpx auto 24rpx;
}

.profile-card {
  padding: 62rpx 38rpx;
  margin-top: 60rpx;
  border-radius: 34rpx;
}

.avatar-wrap {
  width: 180rpx;
  min-width: 180rpx;
  max-width: 180rpx;
  height: 180rpx;
  padding: 0;
  border: 9rpx solid #ffd5e4;
  border-radius: 50%;
  background: #ffe3ea;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  overflow: hidden;
  box-sizing: border-box;
  line-height: 180rpx;
}

.avatar-wrap::after {
  border: 0;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.avatar-plus {
  color: #c94c6c;
  font-size: 60rpx;
}

.avatar-tip {
  text-align: center;
  color: #c94c6c;
  font-size: 28rpx;
  font-weight: 800;
  margin: 20rpx 0 52rpx;
}

.label {
  font-size: 34rpx;
  font-weight: 900;
  margin-bottom: 20rpx;
}

.input-wrap {
  position: relative;
}

.count-text {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  color: #999;
}

.help,
.bottom-tip {
  color: #999;
  font-size: 24rpx;
  margin-top: 18rpx;
}

.save {
  margin-top: 52rpx;
}

.bottom-tip {
  text-align: center;
}

.invite-profile-note {
  margin: 22rpx auto 0;
  color: #c94c6c;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
}

.profile-loading,
.profile-error { margin-top: 28rpx; padding: 40rpx; text-align: center; }
