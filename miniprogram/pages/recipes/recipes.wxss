.recipes-page {
  padding-bottom: 156rpx;
}

.search-card {
  height: 92rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid #f5c3d0;
  box-shadow: 0 14rpx 32rpx rgba(248, 93, 141, 0.07);
  box-sizing: border-box;
}

.search-icon {
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  text-align: center;
  border-radius: 50%;
  background: #ffe3ea;
  color: #c94c6c;
  font-size: 28rpx;
  font-weight: 900;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  color: #4d373e;
  font-size: 28rpx;
}

.clear-button {
  width: 32rpx;
  min-width: 32rpx;
  max-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  flex: 0 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 0;
  background: #4d373e;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  padding: 0;
  box-sizing: border-box;
}

.category-tabs {
  width: 100%;
  white-space: nowrap;
  margin: 0 -32rpx 26rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.tab-track {
  display: inline-flex;
  gap: 16rpx;
  padding: 2rpx 0 14rpx;
}

.category-tab {
  min-width: 112rpx;
  height: 70rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 2rpx solid #f5c3d0;
  color: #8d8580;
  font-size: 26rpx;
  font-weight: 900;
  box-sizing: border-box;
  transition: transform 200ms cubic-bezier(.16, 1, .3, 1), background-color 180ms ease, color 180ms ease;
}

.category-tab.active {
  background: #4d373e;
  border-color: #4d373e;
  color: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(43, 41, 40, 0.13);
}

.result-line {
  margin: -8rpx 0 24rpx;
  color: #9a918b;
  font-size: 24rpx;
}

.recipe-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.recipe-card {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
  padding: 26rpx;
  border-radius: 30rpx;
  background: #ffffff;
  border: 2rpx solid #f1dce1;
  box-shadow: 0 18rpx 44rpx rgba(92, 67, 43, 0.08);
  box-sizing: border-box;
  animation: list-item-enter 280ms cubic-bezier(.22, 1, .36, 1) both;
}

.recipe-cover {
  width: 118rpx;
  height: 118rpx;
  line-height: 118rpx;
  flex: 0 0 118rpx;
  text-align: center;
  border-radius: 28rpx;
  background: #ffe3ea;
  font-size: 56rpx;
}

.recipe-main {
  flex: 1;
  min-width: 0;
}

.recipe-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.recipe-name {
  flex: 1;
  min-width: 0;
  color: #4d373e;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
}

.recipe-meta {
  max-width: 190rpx;
  color: #c94c6c;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.3;
  text-align: right;
}

.recipe-side {
  flex: 0 0 112rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.add-menu-button {
  width: 104rpx;
  min-width: 104rpx;
  max-width: 104rpx;
  height: 38rpx;
  line-height: 38rpx;
  flex: 0 0 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 0;
  background: #4d373e;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 900;
  padding: 0;
  box-sizing: border-box;
}

.add-menu-button.added {
  background: #eeeeee;
  color: #999999;
  box-shadow: none;
}

.recipe-summary {
  margin-top: 12rpx;
  color: #817873;
  font-size: 26rpx;
  line-height: 1.45;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.recipe-tag {
  min-height: 40rpx;
  line-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #4d373e;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
}

.recipe-tag.soft {
  background: #ffe3ea;
  color: #c94c6c;
}

.recipe-detail {
  width: 100%;
  padding-top: 22rpx;
  border-top: 2rpx solid #f1dce1;
}

.detail-title {
  margin: 4rpx 0 14rpx;
  color: #4d373e;
  font-size: 28rpx;
  font-weight: 900;
}

.ingredient-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.ingredient {
  min-height: 46rpx;
  line-height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #fffaf6;
  border: 2rpx solid #f1e1db;
  color: #6d625c;
  font-size: 24rpx;
}

.step-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.step-index {
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  flex: 0 0 42rpx;
  text-align: center;
  border-radius: 50%;
  background: #ff86a4;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
}

.step-text {
  flex: 1;
  min-width: 0;
  color: #574f4b;
  font-size: 26rpx;
  line-height: 1.55;
}

.source-line {
  margin-top: 16rpx;
  color: #aaa19b;
  font-size: 23rpx;
}

.load-more-button {
  width: 100%;
  height: 86rpx;
  line-height: 86rpx;
  border: 0;
  border-radius: 999rpx;
  background: #4d373e;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
}
