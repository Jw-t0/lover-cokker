.order-page {
  padding: 54rpx 30rpx 330rpx;
}

.order-header {
  width: 100%;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 42rpx;
}

.order-header .page-title {
  margin-top: 8rpx;
}

.order-header .page-subtitle {
  margin-bottom: 0;
}

.menu-layout {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 26rpx;
}

.categories {
  width: 146rpx;
  flex: 0 0 146rpx;
  padding: 0;
  overflow: hidden;
  border-radius: 22rpx;
  box-sizing: border-box;
}

.category {
  position: relative;
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b7078;
  font-size: 28rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
}

.category.active {
  color: #c94c6c;
  font-weight: 900;
  background: #ffe3ea;
}

.category-line {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: #c94c6c;
  animation: list-item-enter 180ms ease-out both;
}

.category-name {
  line-height: 1.2;
  text-align: center;
}

.dish-list {
  flex: 1;
  min-width: 0;
}

.cart-bar {
  animation: page-enter 240ms cubic-bezier(.22, 1, .36, 1) 120ms both;
}

.menu-loading {
  min-height: 360rpx;
  padding: 58rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.menu-error,
.menu-notice { margin-top: 24rpx; padding: 28rpx; color: #8b7078; }

.menu-notice { background: #fff8df; }

.loading-icon {
  width: 116rpx;
  height: 116rpx;
  line-height: 116rpx;
  border-radius: 50%;
  background: #ffe3ea;
  color: #c94c6c;
  font-size: 54rpx;
  font-weight: 900;
}

.loading-title {
  margin-top: 28rpx;
  color: #4d373e;
  font-size: 34rpx;
  font-weight: 900;
}

.loading-desc {
  margin-top: 12rpx;
  color: #8b7078;
  font-size: 27rpx;
}

.cart-bar {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(158rpx + env(safe-area-inset-bottom));
  padding: 16rpx 18rpx 18rpx;
  background: rgba(255, 253, 248, 0.98);
  box-shadow: 0 18rpx 42rpx rgba(92, 67, 43, 0.22);
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
  border: 2rpx solid #f1dce1;
  border-radius: 28rpx;
  box-sizing: border-box;
  gap: 16rpx;
}

.cart-summary { min-width: 0; }

.summary {
  font-size: 30rpx;
  font-weight: 900;
}

.cart-link {
  margin-top: 6rpx;
  color: #c94c6c;
  font-size: 26rpx;
  font-weight: 800;
}

.checkout-slot { width: 218rpx; height: 88rpx; flex: 0 0 218rpx; display: flex; align-items: center; justify-content: flex-end; margin-left: auto; }
.checkout-button { width: 218rpx; max-width: 218rpx; min-width: 0; height: 88rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; margin: 0; padding: 0 18rpx; flex: 0 0 218rpx; border-radius: 16rpx; font-size: 27rpx; line-height: normal; box-sizing: border-box; }
.checkout-button.primary-button { background: #4d373e; box-shadow: 0 8rpx 0 #2f2025; }
.checkout-arrow { width: 26rpx; height: 26rpx; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255, 255, 255, 0.18); font-size: 28rpx; line-height: 1; }

.taste-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(34, 29, 23, 0.38);
  animation: overlay-fade-in 220ms ease-out both;
}

.taste-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 81;
  padding: 42rpx 36rpx calc(42rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
  animation: panel-slide-up 340ms cubic-bezier(.16, 1, .3, 1) both;
}

.taste-title {
  font-size: 38rpx;
  font-weight: 900;
  color: #4d373e;
}

.taste-desc {
  margin-top: 12rpx;
  color: #8b7078;
  font-size: 27rpx;
}

.taste-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 34rpx 0;
}

.taste-option {
  min-height: 62rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #ffe3ea;
  color: #c94c6c;
  font-size: 27rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.taste-option.selected {
  background: #4d373e;
  color: #ffffff;
  transform: scale(1.03);
}

.taste-actions {
  display: flex;
  gap: 18rpx;
}

.taste-cancel,
.taste-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border: 0;
  border-radius: 999rpx;
  padding: 0;
  font-size: 28rpx;
  font-weight: 900;
}

.taste-cancel {
  background: #fff8fb;
  color: #825e4b;
}
