.detail-page {
  padding-bottom: 80rpx;
}

.hero {
  display: flex;
  gap: 30rpx;
  padding: 38rpx;
  align-items: center;
  border-radius: 34rpx;
}

.dish-image {
  width: 180rpx;
  height: 180rpx;
  flex: 0 0 180rpx;
  border-radius: 34rpx;
  background: #ffe3ea;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  font-size: 82rpx;
}

.dish-photo {
  width: 100%;
  height: 100%;
}

.dish-main {
  flex: 1;
  min-width: 0;
}

.dish-main .page-title {
  margin: 0 0 18rpx;
}

.price {
  margin-top: 22rpx;
  color: #ff7297;
  font-size: 42rpx;
  font-weight: 900;
}

.info {
  margin-top: 34rpx;
  padding: 40rpx;
  border-radius: 34rpx;
}

.section-title {
  margin: 34rpx 0 16rpx;
  font-size: 32rpx;
  font-weight: 900;
  color: #4d373e;
}

.section-title:first-child {
  margin-top: 0;
}

.content {
  color: #8f8a86;
  font-size: 29rpx;
  line-height: 1.55;
}

.taste-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.taste-tag {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #ffe3ea;
  color: #c94c6c;
  font-size: 25rpx;
  font-weight: 800;
}

.detail-order-button { width: 100%; margin-top: 28rpx; }
.detail-loading,
.detail-error { margin-top: 28rpx; padding: 40rpx; text-align: center; }
