.invite-page {
  min-height: 100vh;
  padding: 38rpx 32rpx 52rpx;
  box-sizing: border-box;
  background: #fff7f5;
  color: #4d373e;
}

.nav-home {
  width: 64rpx;
  height: 64rpx;
  line-height: 58rpx;
  text-align: center;
  color: #9a6774;
  font-size: 48rpx;
  font-weight: 700;
}

.invite-card {
  min-height: 1000rpx;
  margin-top: 38rpx;
  padding: 58rpx 46rpx 48rpx;
  box-sizing: border-box;
  text-align: center;
  border: 2rpx solid #efd8dd;
  border-radius: 28rpx;
  background: #fffdfb;
  box-shadow: 0 20rpx 56rpx rgba(132, 68, 88, 0.11);
}

.invite-loading-card { display: flex; flex-direction: column; align-items: center; justify-content: center; }
.invite-loading-mark { width: 84rpx; height: 84rpx; line-height: 76rpx; border: 6rpx solid #fff2f4; border-radius: 50%; background: #ffe3ea; color: #c94c6c; font-size: 48rpx; text-align: center; animation: invite-loading-pulse 1.2s ease-in-out infinite; }
.invite-loading-title { margin-top: 24rpx; color: #4d373e; font-size: 34rpx; font-weight: 900; }
.invite-loading-desc { margin-top: 10rpx; color: #8b7078; font-size: 24rpx; }

@keyframes invite-loading-pulse {
  0%, 100% { transform: scale(1); opacity: .72; }
  50% { transform: scale(1.08); opacity: 1; }
}

.invite-kicker {
  color: #a16e79;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
}

.seal {
  width: 84rpx;
  height: 84rpx;
  line-height: 76rpx;
  margin: 34rpx auto 26rpx;
  box-sizing: border-box;
  border: 6rpx solid #fff2f4;
  border-radius: 50%;
  background: #ffe3ea;
  color: #c94c6c;
  font-size: 48rpx;
}

.card-rule {
  width: 44rpx;
  height: 3rpx;
  margin: 0 auto 34rpx;
  background: #d88495;
}

.avatar {
  width: 126rpx;
  height: 126rpx;
  margin: 0 auto 20rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #f7dce2;
  border-radius: 50%;
  background: #fff0f3;
  color: #c94c6c;
  font-size: 40rpx;
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.name {
  color: #6e5059;
  font-size: 28rpx;
  font-weight: 800;
}

.title {
  margin-top: 52rpx;
  color: #4d373e;
  font-family: serif;
  font-size: 45rpx;
  font-weight: 900;
  line-height: 1.38;
}

.desc {
  margin: 26rpx auto 0;
  color: #8b7078;
  font-size: 27rpx;
  line-height: 1.65;
}

.expire {
  margin-top: 24rpx;
  color: #aa8790;
  font-size: 23rpx;
}

.creator-actions,
.recipient-actions {
  margin-top: 74rpx;
}

.forward-hint {
  margin-bottom: 22rpx;
  color: #b2526b;
  font-size: 25rpx;
  line-height: 1.55;
}

.invite-action {
  width: 100%;
}

.later {
  margin-top: 26rpx;
  border: 0;
  background: transparent;
  color: #8b7078;
  font-size: 27rpx;
  font-weight: 700;
}

.card-footer {
  margin-top: 34rpx;
  text-align: center;
  color: #b49199;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}
