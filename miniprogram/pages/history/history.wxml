<view class="page">
  <view class="page-title">历史订单</view>
  <view class="page-subtitle">你们吃过的每一顿饭都会留在这里</view>
  <view wx:if="{{loading}}" class="history-loading card">正在整理你们的饭桌记录</view>
  <view wx:elif="{{error}}" class="history-error card">
    <view class="section-title">记录暂时打不开</view>
    <view class="muted">{{error}}</view>
    <button class="soft-button" bindtap="retry">重新加载</button>
  </view>
  <block wx:else>
    <view class="history-card" wx:for="{{orders}}" wx:key="_id">
      <order-card order="{{item}}" />
    </view>
    <empty-state wx:if="{{!orders.length}}" title="暂无历史订单" desc="你们的第一顿饭还在路上" />
    <button wx:if="{{hasMore}}" class="soft-button history-more" disabled="{{loadingMore}}" hover-class="tap-feedback" hover-stay-time="120" bindtap="loadMore">{{loadingMore ? '加载中' : '加载更多'}}</button>
  </block>
  <role-tab-bar current="/pages/history/history" />
</view>
