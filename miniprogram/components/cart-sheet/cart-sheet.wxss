.sheet-wrap {
  position: fixed;
  inset: 0;
  z-index: 120;
  animation: overlay-fade-in 220ms ease-out both;
}

.mask {
  position: absolute;
  inset: 0;
  background: rgba(34, 29, 23, 0.38);
  animation: overlay-fade-in 220ms ease-out both;
}

.sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 34rpx 34rpx 0 0;
  padding: 40rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: panel-slide-up 340ms cubic-bezier(.16, 1, .3, 1) both;
}

.header {
  font-size: 36rpx;
  font-weight: 900;
  margin-bottom: 28rpx;
}

.clear-action {
  color: #c94c6c;
  font-size: 28rpx;
  font-weight: 800;
}

.empty-cart {
  padding: 60rpx 0;
  color: #8b7078;
  text-align: center;
}

.cart-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #eee4d5;
  animation: list-item-enter 240ms ease-out both;
}

.cart-row:nth-child(3) { animation-delay: 40ms; }
.cart-row:nth-child(4) { animation-delay: 80ms; }
.cart-row:nth-child(5) { animation-delay: 120ms; }

.cart-info {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 31rpx;
  font-weight: 900;
  color: #4d373e;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.price {
  margin-top: 8rpx;
  color: #ff7297;
  font-size: 28rpx;
  font-weight: 900;
}

.taste-text {
  display: inline-flex;
  margin-top: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #ffe3ea;
  color: #c94c6c;
  font-size: 22rpx;
  font-weight: 800;
}

.stepper {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  width: 168rpx;
  flex: 0 0 168rpx;
}

.stepper-button {
  width: 52rpx;
  min-width: 52rpx;
  max-width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 0;
  background: #ffe3ea;
  color: #c94c6c;
  line-height: 52rpx;
  padding: 0;
  margin: 0;
  font-size: 30rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.footer {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #4d373e;
  box-sizing: border-box;
}

.footer-price {
  color: #ff7297;
  font-weight: 900;
}

.footer-button {
  width: 218rpx;
  min-width: 218rpx;
  max-width: 218rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 0;
  border-radius: 16rpx;
  margin: 0;
  padding: 0 18rpx;
  flex: 0 0 218rpx;
  font-size: 27rpx;
  font-weight: 900;
  line-height: normal;
  box-sizing: border-box;
  margin-left: auto;
}

.footer-button.primary-button {
  background: #4d373e;
  color: #ffffff;
  box-shadow: 0 8rpx 0 #2f2025;
}

.footer-button.disabled-button {
  background: #f1e9eb;
  color: #a58f96;
  box-shadow: none;
}

.footer-arrow { width: 26rpx; height: 26rpx; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255, 255, 255, 0.18); font-size: 28rpx; line-height: 1; }
