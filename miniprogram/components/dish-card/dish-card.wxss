.dish-card {
  display: flex;
  gap: 20rpx;
  padding: 26rpx;
  margin-bottom: 26rpx;
  align-items: center;
  min-height: 168rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 2rpx solid #f1dce1;
  box-shadow: 0 18rpx 44rpx rgba(92, 67, 43, 0.08);
  box-sizing: border-box;
  animation: list-item-enter 280ms cubic-bezier(.22, 1, .36, 1) both;
}

.dish-image {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #fff8fb, #ffe3ea);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  font-size: 50rpx;
}

.dish-photo {
  width: 100%;
  height: 100%;
}

.dish-main {
  flex: 1;
  min-width: 0;
}

.dish-title-row {
  display: block;
  min-width: 0;
}

.dish-title-row .tag {
  margin-top: 10rpx;
  min-height: 36rpx;
  padding: 0 16rpx;
  font-size: 22rpx;
}

.dish-name {
  font-size: 34rpx;
  font-weight: 900;
  color: #4d373e;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dish-desc {
  color: #8b7078;
  font-size: 26rpx;
  line-height: 1.42;
  margin: 14rpx 0 10rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.dish-action {
  width: 132rpx;
  flex: 0 0 132rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.add-button {
  width: 112rpx;
  min-width: 112rpx;
  max-width: 112rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #ff7297;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  border: 0;
  line-height: 72rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 6rpx;
  width: 128rpx;
  flex: 0 0 128rpx;
  justify-content: flex-end;
}

.stepper-button {
  width: 42rpx;
  min-width: 42rpx;
  max-width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 0;
  background: #ffe3ea;
  color: #c94c6c;
  line-height: 42rpx;
  padding: 0;
  margin: 0;
  font-size: 26rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.stepper-count {
  min-width: 28rpx;
  text-align: center;
  font-weight: 900;
  font-size: 26rpx;
}

.price {
  color: #ff7297;
  font-weight: 900;
  font-size: 30rpx;
  line-height: 1.25;
}

.status {
  display: inline-flex;
  margin-top: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.online {
  color: #c94c6c;
  background: #ffe3ea;
}

.offline {
  color: #999;
  background: #f1e9eb;
}

.manage-actions {
  width: 128rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex: 0 0 128rpx;
  align-items: stretch;
}

.manage-button {
  width: 128rpx;
  min-width: 128rpx;
  max-width: 128rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 0;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 62rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

.edit {
  background: #ff7297;
  color: #fff;
}

.black {
  background: #4d373e;
  color: #fff;
}

.delete {
  background: #fff8fb;
  color: #825e4b;
}
