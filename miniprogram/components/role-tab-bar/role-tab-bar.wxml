<view class="role-tab-safe"></view>
<view class="role-tab-bar">
  <view
    wx:for="{{tabs}}"
    wx:key="text"
    data-url="{{item.url}}"
    bindtap="goTab"
    hover-class="tap-feedback"
    hover-stay-time="120"
    class="role-tab-item {{current === item.url ? 'active' : ''}}"
  >
    <view class="role-tab-icon">{{item.icon}}</view>
    <view class="role-tab-text">{{item.text}}</view>
  </view>
</view>
