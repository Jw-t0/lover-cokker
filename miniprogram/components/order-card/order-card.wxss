.order-card {
  padding: 44rpx 38rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 2rpx solid #f1dce1;
  box-shadow: 0 18rpx 44rpx rgba(92, 67, 43, 0.08);
  box-sizing: border-box;
  animation: list-item-enter 280ms cubic-bezier(.22, 1, .36, 1) both;
}

.status-bar {
  min-height: 82rpx;
  line-height: 1.3;
  border-radius: 20rpx;
  background: #fff3d5;
  color: #a87527;
  font-size: 31rpx;
  font-weight: 900;
  padding: 20rpx 26rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
}

.status-pending {
  background: #fff3d5;
  color: #a87527;
}

.status-accepted {
  background: #dff2dd;
  color: #397950;
}

.status-completed,
.status-reviewed {
  background: #ffe3ea;
  color: #c94c6c;
}

.status-cancelled {
  background: #f1e9eb;
  color: #8b7078;
}

.order-date {
  margin: -12rpx 0 28rpx;
  color: #9a858d;
  font-size: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 900;
  margin: 34rpx 0 20rpx;
}

.item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eee4d5;
  font-size: 30rpx;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-taste {
  display: inline-flex;
  margin-top: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #ffe3ea;
  color: #c94c6c;
  font-size: 22rpx;
  font-weight: 800;
}

.remark {
  color: #8b7078;
  font-size: 30rpx;
  line-height: 1.5;
}

.cancel-reason {
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f8f1f2;
  color: #8b7078;
  font-size: 25rpx;
  line-height: 1.45;
}

.review-box {
  margin-top: 30rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.review-rating {
  color: #ff7297;
  font-size: 30rpx;
  font-weight: 900;
  margin-bottom: 14rpx;
}

.total {
  margin-top: 38rpx;
  font-size: 40rpx;
  font-weight: 900;
}

.total-price {
  color: #4d373e;
  margin-left: 20rpx;
}
