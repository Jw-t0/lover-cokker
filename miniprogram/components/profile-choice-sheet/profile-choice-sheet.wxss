@keyframes profile-choice-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes profile-choice-slide-up {
  from { opacity: 0; transform: translateY(80rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.profile-choice-wrap { position: fixed; inset: 0; z-index: 100; animation: profile-choice-fade-in 220ms ease-out both; }
.profile-choice-mask { position: absolute; inset: 0; background: rgba(53, 34, 40, 0.42); }
.profile-choice-sheet { position: absolute; left: 0; right: 0; bottom: 0; padding: 20rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; background: #fffdfc; box-shadow: 0 -10rpx 36rpx rgba(93, 48, 64, 0.16); box-sizing: border-box; animation: profile-choice-slide-up 340ms cubic-bezier(.16, 1, .3, 1) both; }
.profile-choice-handle { width: 72rpx; height: 8rpx; margin: 0 auto 28rpx; border-radius: 999rpx; background: #f0cbd4; }
.profile-choice-kicker { color: #d65072; font-size: 22rpx; font-weight: 900; text-align: center; letter-spacing: 2rpx; }
.profile-choice-title { margin-top: 8rpx; color: #4d373e; font-size: 40rpx; font-weight: 900; text-align: center; }
.profile-choice-subtitle { margin-top: 10rpx; color: #8b7078; font-size: 23rpx; font-weight: 700; text-align: center; }
.profile-choice-options { display: flex; flex-direction: column; gap: 16rpx; margin-top: 28rpx; }
.profile-choice-option { min-height: 118rpx; display: flex; align-items: center; gap: 18rpx; padding: 20rpx; border: 2rpx solid; border-radius: 24rpx; box-sizing: border-box; }
.profile-choice-complete { border-color: #f5bfd0; background: #fff0f4; }
.profile-choice-direct { border-color: #f0d58e; background: #fff8df; }
.profile-choice-icon { width: 68rpx; height: 68rpx; flex: 0 0 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; background: #fff; color: #d65072; font-size: 38rpx; box-shadow: 0 6rpx 12rpx rgba(150, 74, 98, 0.08); }
.profile-choice-copy { flex: 1; min-width: 0; }
.profile-choice-option-title { color: #4d373e; font-size: 29rpx; font-weight: 900; }
.profile-choice-option-desc { margin-top: 6rpx; color: #8b7078; font-size: 21rpx; line-height: 1.4; }
.profile-choice-arrow { color: #d65072; font-size: 42rpx; font-weight: 800; line-height: 1; }
.profile-choice-cancel { margin-top: 16rpx; padding: 18rpx; color: #9b8188; font-size: 23rpx; font-weight: 800; text-align: center; }

@media (prefers-reduced-motion: reduce) {
  .profile-choice-wrap, .profile-choice-sheet {
    animation: none !important;
  }
}
